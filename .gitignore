# ─────────────────────────────────────────────────────────────────────
#  ⚠️  THIS REPO IS PUBLIC ON GITHUB, including its history.
#  Only the allow-list in .github/workflows/deploy-pages.yml reaches lsccreative.studio,
#  but anything committed here can be read on GitHub.
#  Keep ALL credentials out of it.
# ─────────────────────────────────────────────────────────────────────

# Internal workspace: planning docs, runbooks, Bunny credentials.
# Never published.
client-hub-docs/
.design/

# Credentials — belt and braces, in case a file is ever moved out of the folder above.
*.rtf
*.env
.env*
secrets*
*credentials*

# OS / editor junk (this is what produced the 58 stale deletions in the tree)
.DS_Store
._*
desktop.ini
Thumbs.db
*.swp

# Local dev tooling / scratch — not site content
.claude/
_archive/

# NAS service build output and local SQLite data — never site content
node_modules/
nas/**/data/
*.db
*.db-shm
*.db-wal

# Billing, merged in under admin/ (safeguard S2). admin/.gitignore carries billing's
# own rules too; these stay here so they hold whatever the folder layout becomes.
admin/server/data/
admin/server/.env
admin/web/js/config.js
BILLING.csv
LSC-Service-Agreement*
Visual Design/
.credentials.local.md

# Billing's working docs are tracked; the .design/ rule above is for this repo's own.
!admin/.design/
